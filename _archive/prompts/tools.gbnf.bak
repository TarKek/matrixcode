root ::= think? body

think ::= "<think>" [^<]* "</think>" |
          "<thinking>" [^<]* "</thinking>"

body ::= piece*

piece ::= call | text

text ::= text-byte+

text-byte ::= [^<] |
              "<" [^c] |
              "<c" [^a] |
              "<ca" [^l] |
              "<cal" [^l] |
              "<call" [^ \t\n\r<>-]

call ::= "<call-" ws name sep arg-list close

arg-list ::= ( ws arg )*

arg ::= key sep value

sep ::= ":" | "="

close ::= ws? "-call>" |
          ws? "</call>"

name ::= ident
key ::= ident
ident ::= [a-zA-Z_] [a-zA-Z0-9_]*

value ::= quoted | bare

quoted ::= "\"" qc* "\""
qc ::= [^"\\] | "\\" .

bare ::= bc+
bc ::= [^ \t\n\r<>]

ws ::= [ \t\n\r]+